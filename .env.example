# Copy to .env and adjust. Never commit the real .env file.
APP_ENV=development            # development | production (experiments API disabled outside development)
LOG_LEVEL=INFO
SENTINELML_DB=                 # optional override, e.g. /data/sentinelml.db
CORS_ORIGINS=http://localhost:8501
API_PORT=8000
DASHBOARD_PORT=8501
